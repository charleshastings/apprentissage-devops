<!DOCTYPE html>
<html>
<head>
    <title>AgriTech Dashboard</title>
    <style>
        body { font-family: sans-serif; background-color: #f0fdf4; color: #166534; text-align: center; padding: 50px; }
        .card { background: white; border-radius: 8px; padding: 20px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); display: inline-block; }
        h1 { color: #15803d; }
    </style>
</head>
<body>
    <div class="card">
        <h1> AgriTech Cameroon</h1>
        <p>Bienvenue, Charles Ivan.</p>
        <hr>
        <p>Statut du système : <strong>Opérationnel</strong></p>
    </div>
</body>
</html>
